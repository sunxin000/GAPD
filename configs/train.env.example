# Copy values into your shell or a private config outside version control.
# The scripts consume exported environment variables; they do not auto-load this file.
export DATASET_TYPE=webqsp
export MODEL_PATH=/path/to/dataset-specific-sft-checkpoint
export TRAIN_FILE=/path/to/train.parquet
export VAL_FILE=/path/to/dev.parquet
export SIMCSE_MODEL_PATH=princeton-nlp/sup-simcse-roberta-large
export NGPUS_PER_NODE=8
export FREEBASE_ODBC_DRIVER=Virtuoso
export FREEBASE_ODBC_HOST=localhost
export FREEBASE_ODBC_PORT=13001
# Defaults dba/dba match the local Virtuoso development setup.
# Supply any deployment-specific password privately via FREEBASE_ODBC_PWD.
export SPARQL_URL=http://localhost:8890/sparql
# Source recipe defaults; see docs/REPRODUCIBILITY.md before changing them.
export GAPD_JSD_COEF=0.5
export GAPD_SKIP_SAME_NEXT_STATE=true
export GAPD_SKIP_EXPRESSION_ID_RISK=true
export GAPD_SKIP_HIGH_MID_F1_THRESHOLD=0.9
export WANDB_MODE=offline
